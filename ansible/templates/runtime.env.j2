ENVIRONMENT={{ environment }}
STATE_DIR=/srv/mosprom-{{ environment }}
APP_ENV=prod
DEV_AUTH=0
DOMAIN={{ global_domain }},{{ public_domain }}
WEBAPP_URL=https://{{ global_domain }}/
CORS_ORIGINS=https://{{ global_domain }}
ACME_EMAIL={{ acme_email }}
TLS_SNIPPET=provided
REGION_ID={{ region_id }}
POSTGRES_USER=mosprom_app
POSTGRES_ADMIN_PASSWORD={{ vault_postgres_admin_password }}
POSTGRES_PASSWORD={{ vault_app_password }}
MIGRATION_PASSWORD={{ vault_migration_password }}
REDIS_PASSWORD={{ vault_redis_password }}
INTERNAL_TOKEN={{ vault_internal_token }}
BOT_TOKEN={{ vault_bot_token }}
GRAFANA_PASSWORD={{ vault_grafana_password }}
DATABASE_URL=postgresql+asyncpg://mosprom_app:{{ vault_app_password }}@pg-primary.internal:6432/mosprom
MIGRATION_DATABASE_URL=postgresql+asyncpg://mosprom_migrate:{{ vault_migration_password }}@pg-primary.internal:5433/mosprom
DB_TLS=1
DB_CA_FILE=/tls/ca.crt
PGBOUNCER=1
REDIS_URL=redis://unused:6379/0
REDIS_SENTINEL_NODES={% for host in groups['redis_nodes'] %}{{ hostvars[host].wg_ip }}:26379{{ ',' if not loop.last else '' }}{% endfor %}

REDIS_TLS=1
ETCD_ENDPOINTS={% for host in groups['dcs'] %}https://{{ hostvars[host].wg_ip }}:2379{{ ',' if not loop.last else '' }}{% endfor %}

API_WORKERS={{ api_workers | default(2) }}
SIM_WORKERS={{ sim_workers | default(2) }}
DB_POOL_SIZE={{ db_pool_size | default(5) }}
DB_MAX_OVERFLOW={{ db_max_overflow | default(5) }}
API_CPUS={{ api_cpus | default(2) }}
API_MEMORY={{ api_memory | default('768m') }}
SIM_CPUS={{ sim_cpus | default(2) }}
SIM_MEMORY={{ sim_memory | default('640m') }}
COMPOSE_PROFILES=monitoring
DISCOVERY_CA_FILE=/tls/ca.crt

WG_IP={{ wg_ip }}
