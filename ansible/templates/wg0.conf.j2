[Interface]
Address = {{ wg_ip }}/24
ListenPort = {{ wireguard_port }}
PrivateKey = {{ vault_wireguard_private_key }}
{% for host in groups['mosprom'] if host != inventory_hostname %}
[Peer]
PublicKey = {{ vault_wireguard_public_keys[host] }}
AllowedIPs = {{ hostvars[host].wg_ip }}/32
Endpoint = {{ hostvars[host].ansible_host }}:{{ wireguard_port }}
PersistentKeepalive = 25
{% endfor %}
