global
  log stdout format raw local0
defaults
  mode tcp
  timeout connect 3s
  timeout client 30s
  timeout server 30s
frontend postgres_write
  bind {{ wg_ip }}:5433
  default_backend primary
backend primary
  option httpchk GET /primary
  http-check expect status 200
{% for host in groups['mosprom'] %}
  server {{ host }} {{ hostvars[host].wg_ip }}:5432 check port 8008 check-ssl verify required ca-file /tls/ca.crt crt /tls/haproxy.pem inter 2s fall 2 rise 2
{% endfor %}
