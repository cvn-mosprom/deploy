# Copy outside git to /srv/mosprom-<environment>/.env; generate independent secrets per environment.
ENVIRONMENT=staging
STATE_DIR=/srv/mosprom-staging
APP_ENV=prod
DEV_AUTH=0
DOMAIN=staging.game.example.com
WEBAPP_URL=https://staging.game.example.com/
CORS_ORIGINS=https://staging.game.example.com
ACME_EMAIL=ops@example.com
REGION_ID=local
POSTGRES_USER=mosprom_app
POSTGRES_ADMIN_PASSWORD=replace-me
POSTGRES_PASSWORD=replace-me
MIGRATION_PASSWORD=replace-me
REDIS_PASSWORD=replace-me
INTERNAL_TOKEN=replace-me
BOT_TOKEN=replace-me
GRAFANA_PASSWORD=replace-me
DATABASE_URL=postgresql+asyncpg://mosprom_app:replace-me@db:5432/mosprom
MIGRATION_DATABASE_URL=postgresql+asyncpg://mosprom_migrate:replace-me@db:5432/mosprom
REDIS_URL=redis://:replace-me@redis:6379/0
REDIS_SENTINEL_NODES=
REDIS_TLS=0
ETCD_ENDPOINTS=
PGBOUNCER=0
HR_ADMIN_TG_IDS=
HR_CHAT_ID=
API_WORKERS=2
SIM_WORKERS=2
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
API_CPUS=2
API_MEMORY=768m
SIM_CPUS=2
SIM_MEMORY=640m
DB_CPUS=2
DB_MEMORY=2g
COMPOSE_PROFILES=single,monitoring
# Off-host encrypted restic repository; password file and credentials are provisioned outside git.
RESTIC_REPOSITORY=s3:https://backup.example.com/mosprom-staging
RESTIC_PASSWORD_FILE=/srv/mosprom-staging/restic-password
