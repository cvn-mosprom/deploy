{
  admin off
  persist_config off
}
(acme) {
  tls {$ACME_EMAIL}
}
(provided) {
  tls /tls/ingress.crt /tls/ingress.key
}
:8081 {
  respond /health 200
}
{$DOMAIN} {
  import {$TLS_SNIPPET:acme}
  import /etc/caddy/content-security-policy.caddy
  encode zstd gzip
  redir /landing / 308
  redir /landing/ / 308
  header {
    Strict-Transport-Security "max-age=31536000"
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
  }
  log {
    format filter {
      wrap json
      fields {
        request>headers>X-Telegram-Init-Data delete
        request>headers>X-Dev-User delete
        request>headers>Authorization delete
        request>headers>Cookie delete
      }
    }
  }
  @private path /internal /internal/* /metrics
  handle @private {
    respond 404
  }
  handle /lb-ready {
    rewrite * /ingress-ready
    reverse_proxy discovery:8080
  }
  handle /routing/regions {
    reverse_proxy discovery:8080
  }
  @api path /api/* /health /ready /routing/ping /routing/report
  handle @api {
    request_body {
      max_size 2MB
    }
    reverse_proxy api:8000 {
      transport http {
        dial_timeout 3s
        response_header_timeout 15s
      }
    }
  }
  handle {
    root * /srv
    @immutable path /_app/immutable/*
    header @immutable Cache-Control "public, max-age=31536000, immutable"
    @pages not path /_app/immutable/* /fonts/* /audio/* /icons/* /labels/* /landing/*
    header @pages Cache-Control no-cache
    try_files {path} {path}/index.html {path}.html /200.html
    file_server
  }
}

# Published on WireGuard only by the HA overlay; never on a public host interface.
http://:9443 {
  handle /discovery-metrics {
    rewrite * /metrics
    reverse_proxy discovery:8080
  }
  handle /metrics {
    reverse_proxy api:8000
  }
  respond 404
}
